# Geo 数据更新地址（管理端 Geo 页面「更新数据」使用；留空时使用内置默认地址）
GEOIP_URL=https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.dat
GEOSITE_URL=https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat
GEODB_URL=https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb
GEOASN_URL=https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/GeoLite2-ASN.mmdb

# 生成命令：openssl rand -hex 32（生产必改；更换会导致已加密字段无法解密）
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# 对外访问根地址（生成订阅链接用；须与浏览器实际访问一致，公网请用 https://你的域名）
PUBLIC_BASE_URL=http://localhost:8080

# 拉取机场订阅的 User-Agent（版本号可以与 Clash Verge 对齐；改后重启并重新「拉取」）
SOURCE_FETCH_UA=clash-verge/v2.5.3

# 自动刷新全部启用订阅源的间隔（小时，只写数字；改后重启生效）
SOURCE_REFRESH_INTERVAL=24

# development=本机开发；production=正式部署
APP_ENV=development

# 监听地址
HTTP_ADDR=:8080

# 可信反向代理的 IP/CIDR（逗号分隔）。部署在 Nginx/Docker 后必填，
# 否则限流与审计只会记到代理 IP。示例：Docker 默认网桥 172.17.0.0/16
# 直接裸跑（无代理）留空即可。与 COOKIE_SECURE 独立（一个管真实 IP，一个管 Cookie）。
TRUSTED_PROXIES=

# 会话 Cookie 是否带 Secure。默认 false（http://IP:端口 可登录）；
# 经 HTTPS 反代/公网访问时设 true（浏览器仅在 HTTPS 下发送 Cookie）。
COOKIE_SECURE=false

# 日志输出：console=仅控制台 | file=仅文件 | both=两者 | none=关闭
LOG_OUTPUT=both
# 详细地区识别/过滤日志；production 默认关闭，显式配置优先
DEBUG_LOGGING=false
# 日志保留天数（0=不清理）
LOG_RETENTION_DAYS=7
# 时区（默认 Asia/Shanghai；影响日志时间戳、按日切分等本地时间）
TZ=Asia/Shanghai
