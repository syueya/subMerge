# ≥32 字符，加密上游订阅 URL 与分享令牌（务必改成唯一随机值，否则启动会被拒绝）
# 生成命令：openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# 对外访问根地址（生成订阅链接用；公网请改成 https://你的域名）
PUBLIC_BASE_URL=http://localhost:8080

# 拉取机场订阅的 User-Agent（版本号可以与 Clash Verge 对齐；改后重启并重新「拉取」）
SOURCE_FETCH_UA=clash-verge/v2.5.3

# 自动刷新全部启用订阅源的间隔（小时，只写数字；改后重启生效）
SOURCE_REFRESH_INTERVAL=24

# development=本机开发；production=正式部署
APP_ENV=development

# 监听地址
HTTP_ADDR=:8080

# 可信反向代理的 IP/CIDR（逗号分隔）。部署在 Nginx/Docker 后必填，
# 否则限流与审计只会记到代理 IP。示例：Docker 默认网桥 172.17.0.0/16
# 直接裸跑（无代理）留空即可。
TRUSTED_PROXIES=

# 日志输出：console=仅控制台 | file=仅文件 | both=两者 | none=关闭
LOG_OUTPUT=both
# 日志保留天数（0=不清理）
LOG_RETENTION_DAYS=7
# 时区（默认 Asia/Shanghai；影响日志时间戳、按日切分等本地时间）
TZ=Asia/Shanghai
