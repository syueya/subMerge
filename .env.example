# ≥32 字符，加密上游订阅 URL 与分享令牌（务必改掉）
ENCRYPTION_KEY=change-me-to-a-long-random-secret-key

# 对外访问根地址（生成订阅链接用；公网请改成 https://你的域名）
PUBLIC_BASE_URL=http://localhost:8080

# 拉取机场订阅的 User-Agent（版本号可以与本机 Clash Verge 对齐；改后重启并重新「拉取」）
SOURCE_FETCH_UA=clash-verge/v2.5.3

# development=本机开发；production=正式部署
APP_ENV=development

# 监听地址
HTTP_ADDR=:8080

# 日志输出：console=仅控制台 | file=仅文件 | both=两者 | none=关闭
LOG_OUTPUT=both
# 日志保留天数（0=不清理）
LOG_RETENTION_DAYS=7
# 时区（默认 Asia/Shanghai；影响日志时间戳、按日切分等本地时间）
TZ=Asia/Shanghai
